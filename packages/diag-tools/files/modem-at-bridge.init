#!/bin/sh /etc/rc.common
# /etc/init.d/modem-at-bridge
# AT command bridge between USB Gadget ACM (/dev/ttyGS0) and Modem AT port

START=95
STOP=10

USE_PROCD=1
PROG=/usr/bin/modem_at_bridge

start_service() {
	local gadget_port="/dev/ttyGS0"
	local modem_port=""

	if [ -f /etc/config/usbgadget ]; then
		. /lib/functions.sh
		config_load usbgadget
		config_get modem_port acm modem_port ""
	fi

	[ -z "$modem_port" ] && {
		for p in /dev/wwan0at1 /dev/wwan0at0 /dev/smd11 /dev/smd7; do
			if [ -c "$p" ]; then
				modem_port="$p"
				break
			fi
		done
	}
	[ -z "$modem_port" ] && modem_port="/dev/wwan0at1"

	procd_open_instance
	procd_set_param command "$PROG" -g "$gadget_port" -m "$modem_port"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall modem_at_bridge 2>/dev/null || true
}
